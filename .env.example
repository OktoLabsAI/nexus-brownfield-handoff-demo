# Copy to .env, fill in real values, then:
#   export $(grep -v '^#' .env | xargs)
# before running anything in scripts/. Never commit the filled-in .env.

# --- Nexus server ---
NEXUS_URL=http://127.0.0.1:8202
NEXUS_PROJECT_ROOT=/absolute/path/to/your/clone/of/nexus-brownfield-handoff-demo-repo

# --- Agent identities ---
# Populate these after scripts/01_register_agents.py runs -- it prints the
# api_key for each agent it creates. Do not hand-pick these; each fresh
# clone/run should register its own agents rather than reusing anyone else's.
SCHEMA_AGENT_ID=schema-agent
SCHEMA_API_KEY=

API_AGENT_ID=api-agent
API_API_KEY=

# The reserved built-in identity Nexus ships with, used for admin/REST calls
# (policy creation, approval decisions). Get this from your Nexus install's
# own setup output, not from this repo.
OPERATOR_API_KEY=

# --- Target app database (docker-compose.yml wires this up for you) ---
DATABASE_URL=postgresql://realworld:realworld@localhost:5433/realworld
